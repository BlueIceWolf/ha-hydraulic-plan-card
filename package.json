{
  "name": "ha-hydraulic-plan-card",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "HACS dashboard card for boilers, heat pumps and hydronic heating systems",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "syntax": "node --check dist/ha-hydraulic-plan-card.js && node --check demo/setups.js",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "check": "npm run syntax && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
